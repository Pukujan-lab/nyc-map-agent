{
  "name": "nyc-map-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**' --exclude '**/node_modules/**'",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts status",
    "db:refresh": "tsx scripts/refresh-marts.ts",
    "ingest": "tsx scripts/ingest.ts && tsx scripts/refresh-marts.ts",
    "build:city-tiles": "tsx scripts/build-city-tiles.ts",
    "load:areas": "tsx scripts/load-areas.ts",
    "build:aggregates": "tsx scripts/build-aggregates.ts",
    "start": "tsx server/node.ts",
    "build:sign-tiles": "tsx scripts/build-sign-tiles.ts",
    "build:skyline-tiles": "tsx scripts/build-skyline-tiles.ts",
    "publish:city-tiles": "tsx scripts/publish-city-tiles.ts",
    "build:block-tiles": "tsx scripts/build-block-tiles.ts",
    "publish:block-tiles": "tsx scripts/publish-city-tiles.ts public/tiles/nyc-blocks.pmtiles && tsx scripts/publish-city-tiles.ts public/tiles/nyc-blocks.geojson",
    "lint:boundaries": "depcruise src server api scripts --config .dependency-cruiser.cjs",
    "build:size": "vite build --outDir .size-build --emptyOutDir",
    "size": "size-limit",
    "feeds:health": "tsx scripts/feed-health.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "lint": "eslint . --max-warnings=0 --suppressions-location eslint-suppressions.json --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --suppressions-location eslint-suppressions.json --prune-suppressions",
    "knip": "knip --no-progress",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "build:transit": "tsx scripts/build-transit.ts",
    "build:e2e": "VITE_DATA_BACKEND=octo vite build --outDir .e2e-build --emptyOutDir",
    "e2e": "playwright test",
    "build:xray": "tsx scripts/build-xray.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "0.19.10",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-collapsible": "1.1.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-query": "5.59.0",
    "@types/geojson": "7946.0.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/suncalc": "1.9.2",
    "@vitejs/plugin-react": "4.3.3",
    "ai": "7.0.143",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "downshift": "9.4.0",
    "gtfs-realtime-bindings": "1.1.1",
    "hono": "4.13.13",
    "lucide-react": "0.454.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.3.0",
    "postcss": "8.4.47",
    "proj4": "2.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "8.1.3",
    "react-router-dom": "6.30.6",
    "recharts": "2.13.3",
    "sonner": "1.7.0",
    "suncalc": "1.9.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "three": "0.134.0",
    "typescript": "5.6.3",
    "vaul": "1.1.2",
    "vite": "5.4.10",
    "vitest": "2.1.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@size-limit/file": "11.2.0",
    "@types/node": "22.10.2",
    "@types/three": "0.134.0",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "knip": "5.66.0",
    "mapshaper": "0.7.89",
    "size-limit": "11.2.0",
    "tsx": "4.19.2",
    "typescript-eslint": "8.46.4"
  },
  "packageManager": "pnpm@11.19.0"
}
