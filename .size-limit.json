    "path": ".size-build/assets/AgentOverlay-*.js",
    "limit": "25 kB"
  },
  {
    "name": "lib: screen space (xstate, lazy)",
    "path": ".size-build/assets/screenSpace-*.js",
    "limit": "13.5 kB"
  },
  {
    "name": "feature: city3d (lazy)",
    "path": ".size-build/assets/city3d-*.js",
    "limit": "2.7 kB"
  },
  {
    "name": "feature: daylight (lazy)",
    "path": ".size-build/assets/daylightLayers-*.js",
