  },
  {
    "name": "feature: weather (lazy)",
    "path": ".size-build/assets/weatherLayers-*.js",
    "limit": "2 kB"
  },
  {
    "name": "feature: hazards (lazy)",
    "path": ".size-build/assets/hazardsLayers-*.js",
    "limit": "2 kB"
  },
  {
    "name": "feature: traffic (lazy)",
    "path": ".size-build/assets/trafficLayers-*.js",
