# ---------------------------------------------------------------------------
# Server-side only. Never exposed to the browser bundle (no VITE_ prefix).
# Used by the model layer that runs in your hosting environment, not by this app.
# ---------------------------------------------------------------------------
INFERHUB_API_KEY=

# ---------------------------------------------------------------------------
# Browser-visible configuration (safe to expose).
# ---------------------------------------------------------------------------

# Optional Socrata app token. The app works without it; with it you get much
# higher rate limits when pulling ~200k 311 rows.
# https://data.cityofnewyork.us/profile/edit/developer_settings
VITE_SOCRATA_APP_TOKEN=

# Basemap raster tiles. Defaults to the OSM public tiles (fine for a demo, not
# for public traffic). Point this at a hosted provider for real traffic.
VITE_TILE_URL=

# "mock" (default) uses the built-in deterministic agent.
# "http" posts to /api/chat and expects the contract documented in
# src/lib/agent/httpAgent.ts.
VITE_AGENT_MODE=mock
