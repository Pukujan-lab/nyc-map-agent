# ---------------------------------------------------------------------------
# Server-side only. Never exposed to the browser bundle (no VITE_ prefix).
# Used by the model layer that runs in your hosting environment, not by this app.
# ---------------------------------------------------------------------------
INFERHUB_API_KEY=
# Smart-mode agent (POST /api/agent). Defaults shown; both optional.
# INFERHUB_BASE_URL=https://api.inferhub.dev/v1
# INFERHUB_MODEL=cb/deepseek-v4.1-flash
# Optional comma-separated fallbacks, tried on 402, 4xx model_not_found or 5xx.
# INFERHUB_MODEL_FALLBACKS=
# Agent fair use (per client address; kept in memory by the single server process). 0 turns a limit off.
# AGENT_RATE_WINDOW_MAX=20
# AGENT_RATE_WINDOW_HOURS=3
# AGENT_RATE_BURST_MAX=5
# AGENT_RATE_BURST_SECONDS=60
# Global daily token budget (UTC day). Past the cap the agent uses AGENT_CAP_MODEL if set,
# otherwise it replies without a model; past the hard cap it always replies without a model.
# AGENT_DAILY_TOKEN_CAP=3000000
# AGENT_DAILY_TOKEN_HARD_CAP=4000000
# AGENT_CAP_MODEL=
# Driving trips: the public OSRM car server is for light use only; point this at your own OSRM.
# DRIVE_ROUTER_URL=https://routing.openstreetmap.de/routed-car
# 511NY events/construction for driving trips (free key: https://511ny.org/developers). Optional.
NY511_API_KEY=

# ---------------------------------------------------------------------------
# Browser-visible configuration (safe to expose).
# ---------------------------------------------------------------------------

# Optional Socrata app token. The app works without it; with it you get much
# higher rate limits when pulling ~200k 311 rows and the extra registry sources
# (all 311, HPD violations, PLUTO, street trees, ramps, speed humps, SIP).
# https://data.cityofnewyork.us/profile/edit/developer_settings
VITE_SOCRATA_APP_TOKEN=

# Basemap raster tiles. Defaults to the OSM public tiles (fine for a demo, not
# for public traffic). Point this at a hosted provider for real traffic.
VITE_TILE_URL=

# Mapillary client access token — enables the street-level photo sheet.
# Client tokens are meant for browsers, so this one is visible in the bundle.
# Without it the "Street view" button explains how to add one; everything else
# in the app keeps working.
# https://www.mapillary.com/dashboard/developers
# Either name works: MAPILLARY_TOKEN is exposed to the client through
# `envPrefix: ["VITE_", "MAPILLARY_"]` in vite.config.ts. Set only one.
VITE_MAPILLARY_TOKEN=
# MAPILLARY_TOKEN=

# Walking directions (OSRM foot profile). Defaults to the public FOSSGIS server
# https://routing.openstreetmap.de/routed-foot. It is a shared community
# service, so keep usage light, or point this at your own OSRM instance.
VITE_OSRM_URL=

# "mock" (default) uses the built-in deterministic agent.
# "http" posts to /api/chat and expects the contract documented in
# src/lib/agent/httpAgent.ts.
VITE_AGENT_MODE=mock

# ---------------------------------------------------------------------------
# Octo data layer (server only; used by /api functions and scripts/*.ts).
# ---------------------------------------------------------------------------
OCTO_API_KEY=
OCTO_WORKSPACE_ID=
# OCTO_BASE_URL=https://octodb.design-bakery.com
# Ingestion: Socrata API key id/secret (Basic auth) or an app token. All optional.
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=
SOCRATA_APP_TOKEN=
# INGEST_MONTHS=12
# Dev: proxy /api to another running instance (e.g. `pnpm start`) instead of the in-Vite Hono app.
# API_PROXY_TARGET=http://localhost:3000

# Browser: `octo` reads /api (Octo marts, filters on); default `socrata` queries NYC Open Data directly.
VITE_DATA_BACKEND=socrata
# VITE_API_BASE=

# MTA Bus Time key (server only) for live bus positions at /api/transit/bus.
# Without it the Buses toggle is hidden. Subway / LIRR / Metro-North need no key.
# https://register.developer.obanyc.com/
MTA_BUSTIME_KEY=

# Event lookup on request (TinyFish search + fetch). Optional: without it the agent says event lookup is unavailable.
TINYFISH_API_KEY=
# Speech-to-text for browsers without a working recognizer (Brave, Firefox). Any OpenAI-compatible
# transcription API; default Groq Whisper. Optional: without a key the app says voice is not set up.
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
