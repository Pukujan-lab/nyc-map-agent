    "header_text": {
     "translation": [
      {
       "text": "In Queens, all Manhattan-bound [7][7X] local/express trains stop at 74 St-Broadway",
       "language": "en"
      },
      {
       "text": "<p>In Queens, all Manhattan-bound ‌[7][7X] local/express trains stop at <strong>74 St-Broadway</strong></p>",
       "language": "en-html"
      }
     ]
    },
    "description_text": {
     "translation": [
      {
       "text": "Flushing-bound [7X] express trains skip 74 St-Broadway.\nFlushing-bound [7] local trains will continue to stop at 74 St-Broadway.\n\nFor service to 74 St-Broadway and/or transfer to Jackson Hts-Roosevelt Av [E][F][M][R], transfer at Woodside-61 St to a Flushing-bound [7] local.\n\nAdditional travel alternatives:\nFor service to this station, take the [7X] to Junction Blvd and transfer to a Manhattan-bound [7][7X].\n\nWhat's happening?\nWe're making structural improvements",
       "language": "en"
      },
      {
       "text": "<p>Flushing-bound [7X] express trains skip <strong>74 St-Broadway</strong>.</p><p>Flushing-bound [7] local trains will continue to stop at <strong>74 St-Broadway</strong>.</p><p style=\"min-height:10px\"></p><p>For service to <strong>74 St-Broadway</strong> and/or transfer to <strong>Jackson Hts-Roosevelt Av</strong> [E][F][M][R], transfer at ‌<strong>Woodside-61 St</strong> to a Flushing-bound [7] local.</p><p style=\"min-height:10px\"></p><p><strong>Additional travel alternatives:</strong></p><p>For service to this station, take the [7X] to <strong>Junction Blvd</strong> and transfer to a Manhattan-bound [7][7X].</p><p style=\"min-height:10px\"></p><p><strong>What's happening?</strong></p><p>We're making structural improvements</p>",
       "language": "en-html"
      }
     ]
    },
