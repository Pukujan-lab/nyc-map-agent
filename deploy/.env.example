# Copy to /srv/nyc-map-agent/.env and chmod 600. Never commit this file.

# --- Deploy service ---------------------------------------------------------
CD_ADMIN_PASSWORD=
CD_SESSION_SECRET=
CD_DEPLOY_TOKEN=

# --- App image (build-time, public) ----------------------------------------
VITE_DATA_BACKEND=octo
MAPILLARY_TOKEN=

# --- App runtime secrets ----------------------------------------------------
OCTO_API_KEY=
OCTO_WORKSPACE_ID=
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
MTA_BUSTIME_KEY=
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=

# --- Deploy service, host plumbing (optional; defaults match gravebuster) ---
# CD_UID / CD_GID          owner of the checkout; the CD container runs as them
# CD_DOCKER_GID            gid of /var/run/docker.sock on the host
# CD_GIT_CREDENTIALS       host path to a git credential store for the private
#                          repo; mounted read-only at /tmp/.git-credentials

# Optional, server only. Event lookup on request (TinyFish search + fetch).
TINYFISH_API_KEY=
# Optional, server only. Speech-to-text for Brave/Firefox: any OpenAI-compatible Whisper API.
# Default is Groq (get a key at console.groq.com); for OpenAI set STT_BASE_URL=https://api.openai.com/v1 and STT_MODEL=gpt-4o-mini-transcribe.
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
