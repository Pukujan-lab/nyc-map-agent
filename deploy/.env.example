# Copy to /srv/nyc-map-agent/.env and chmod 600. Never commit this file.

# --- Deploy service ---------------------------------------------------------
CD_ADMIN_PASSWORD=
CD_SESSION_SECRET=
CD_DEPLOY_TOKEN=

# --- App image (build-time, public) ----------------------------------------
VITE_DATA_BACKEND=octo
MAPILLARY_TOKEN=

# --- App runtime secrets ----------------------------------------------------
OCTO_API_KEY=
OCTO_WORKSPACE_ID=
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
MTA_BUSTIME_KEY=
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=
