{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "server/app.ts",
    "scripts/*.ts",
    "api/**/*.ts",
    "src/lib/geo/*.worker.ts",
    "src/features/index.ts",
    "deploy/cd/server.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "deploy/**/*.ts"
  ],
  "ignore": ["dist/**", ".size-build/**", "deploy/dashboard/**"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
